# PostgreSQL (container tcg-db)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Backend
# PORT: porta em que a API escuta. BACKEND_PORT: porta do seu computador ligada ao container da API.
NODE_ENV=development
PORT=3000
BACKEND_PORT=
DATABASE_URL=
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
USE_MOCK=false
# AUTH_RATE_LIMIT: tentativas sem sucesso por IP e e-mail a cada 15 min, contadas à parte no login e no cadastro (padrão 20; 0 desliga)
AUTH_RATE_LIMIT=
# LOG_LEVEL: fatal, error, warn, info, debug, trace ou silent (padrão: info; silent nos testes)
LOG_LEVEL=

# Traces (OpenTelemetry). Vazio = desligado. Com o Jaeger local (make traces):
# http://localhost:4318 com o backend fora do Docker, http://jaeger:4318 com o backend no compose.
# No deploy: endpoint OTLP do Grafana Cloud e o header de autorização (segredo, só no painel do Render).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=pokebox-backend

# CORS: sites que podem chamar a API pelo navegador, separados por vírgula
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
CORS_ORIGIN_REGEX=

# Prisma CLI
PRISMA_DATABASE_URL=""

# Frontend
FRONTEND_PORT=

# Seed: senhas dos usuários do seed (8 a 72 caracteres, diferentes entre si). Nunca escreva os valores no Git.
# SEED_ADMIN_PASSWORD vale para o admin; SEED_DEMO_PASSWORD para ash e misty.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# Auth (JWT_SECRET com pelo menos 16 caracteres)
JWT_SECRET=
JWT_EXPIRES_IN=1d
